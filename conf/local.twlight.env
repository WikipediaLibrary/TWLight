DJANGO_DB_HOST=db
DJANGO_EMAIL_BACKEND=django_dkim.backends.console.EmailBackend
DKIM_SELECTOR=local
DKIM_DOMAIN=localhost
DJANGO_EMAIL_HOST=localhost
TWLIGHT_HOME=/app
TWLIGHT_BACKUP_DIR=/app/backup
TWLIGHT_ENV=local
TWLIGHT_UNIXNAME=root
TWLIGHT_ERROR_MAILTO=wikipedialibrary@wikimedia.org
USER=root
ALLOWED_HOSTS=localhost 127.0.0.1 [::1]
REQUEST_BASE_URL=http://localhost/
DEBUG=True
TWLIGHT_OAUTH_PROVIDER_URL=https://meta.wikimedia.org/w/index.php
TWLIGHT_OAUTH_TIMESTAMP_LEEWAY=600
TWLIGHT_API_PROVIDER_ENDPOINT=https://meta.wikimedia.org/w/api.php
TWLIGHT_EZPROXY_URL=https://ezproxy.dev.localdomain:2443
MW_API_URL=http://host.docker.internal:8080/w/api.php
# seeem to be having troubles with --workers > 1
GUNICORN_CMD_ARGS=--name twlight --workers 1 --backlog 2048 --timeout 300 --bind=0.0.0.0:80 --forwarded-allow-ips * --reload --log-level=info

# Dev-only credentials. Not real secrets: MW_API_EMAIL_* is the Admin
# account on the accompanying MediaWiki dev wiki, DKIM_PRIVATE_KEY is a
# placeholder since local email uses the console backend, and everything
# else is the string "twlight". For staging/production, .env supplies
# the real values.
DJANGO_DB_NAME=twlight
DJANGO_DB_USER=twlight
DJANGO_DB_PASSWORD=twlight
MYSQL_ROOT_PASSWORD=twlight
SECRET_KEY=twlight
TWLIGHT_OAUTH_CONSUMER_KEY=42b486d69d24a109c49e12673895b3aa
TWLIGHT_OAUTH_CONSUMER_SECRET=3c89911e1981b9bc2777618eeca4e7d22d25821e
TWLIGHT_EZPROXY_SECRET=twlight
MW_API_EMAIL_USER=Admin
MW_API_EMAIL_PASSWORD=dockerpass
DKIM_PRIVATE_KEY=devkey
