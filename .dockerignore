# Without this, a local build copies whatever is sitting in the checkout:
# a stray gitignored twlight.sql once accounted for most of the image. CI
# builds from a clean checkout and never saw it. collectedstatic gets
# regenerated by bin/static.sh, so the local copy is only stale weight.
.git
**/*.sql
backup/
media/
**/__pycache__/
**/*.pyc
venv/
/lib/
.claude/
.wmaid/
**/*.log
.idea/
**/node_modules/
TWLight/collectedstatic/
.env
